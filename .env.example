# Copie este arquivo para .env e preencha com os dados do NOVO projeto Supabase.
# NUNCA commite o .env de verdade — ele já deve estar no .gitignore.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUA_ANON_KEY_AQUI
VITE_SUPABASE_PROJECT_ID=seu-projeto-id

# Secrets das Edge Functions (configurar no painel do Supabase, não aqui):
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY  (injetados automaticamente pelo Supabase)
#   ALLOWED_ORIGINS   -> ex: https://app.k2network.com,https://preview.lovable.app
#   QRATOR_API_KEY
#   RIPE_ATLAS_API_KEY
